#include <winver.h>
#include "../src/version.h"

1 ICON "on.ico"
2 ICON "off.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     TS_VERSION_MAJOR,TS_VERSION_MINOR,TS_VERSION_PATCH,0
PRODUCTVERSION  TS_VERSION_MAJOR,TS_VERSION_MINOR,TS_VERSION_PATCH,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080904B0"
    BEGIN
      VALUE "FileDescription", "TouchSplit - independent touchscreen and mouse"
      VALUE "ProductName", "TouchSplit"
      VALUE "FileVersion", TS_VERSION_STR
      VALUE "ProductVersion", TS_VERSION_STR
      VALUE "OriginalFilename", "TouchSplit.exe"
      VALUE "LegalCopyright", "MIT License"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0809, 1200
  END
END
